  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "name": "Demo Application",
      "description": "Demo application for testing phone authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-app-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "https://oauth.pstmn.io/v1/callback"
